Cell[CellGroupData[{

Cell["Section 5: Precompute Crank-Nicolson matrices in k-space", "Section",ExpressionUUID->"ac105398-f319-44f4-b619-46401c89b714"],

Cell[CellGroupData[{

Cell["\<\
(* Standard FFT frequency ordering (Mathematica Fourier):
   n=1           -> k=0
   n=2..Nx/2+1   -> k = 2Pi(n-1)/Nx   (positive, including k=Pi at n=Nx/2+1)
   n=Nx/2+2..Nx  -> k = 2Pi(n-1-Nx)/Nx (negative) *)
kxGrid = Table[
  If[n <= Nx/2 + 1, 2 Pi (n - 1)/Nx, 2 Pi (n - 1 - Nx)/Nx],
  {n, 1, Nx}];
kyGrid = Table[
  If[m <= Ny/2 + 1, 2 Pi (m - 1)/Ny, 2 Pi (m - 1 - Ny)/Ny],
  {m, 1, Ny}];

Print[\"kxGrid sample {n=1,60,61,62,120}: \", kxGrid[[{1, 60, 61, 62, \
120}]]];
Print[\"kyGrid sample {m=1,40,41,42,80}: \",  kyGrid[[{1, 40, 41, 42, 80}]]];

(* Precompute CN step matrices: M_k = (P_k + i dt/2 H_k)^{-1} (P_k - i dt/2 \
H_k)
   Zone-boundary guard: P=H=0 there, so Det[A]=0; use identity matrix.
   Store as a flat list cnMatsFlat of length Nx*Ny for vectorised \
application. *)
Print[\"Precomputing CN matrices ...\"];
cnMatsFlat = Flatten[
  Table[
    Module[{Hk, Pk, A, B},
      Hk = N[HTF[kxGrid[[n]], kyGrid[[m]]]];
      Pk = N[PTF[kxGrid[[n]], kyGrid[[m]]]];
      A  = Pk + I (dt/2) Hk;
      B  = Pk - I (dt/2) Hk;
      If[Abs[Det[A]] < 1*^-10,
        IdentityMatrix[3],
        Inverse[A].B
      ]
    ],
    {n, 1, Nx}, {m, 1, Ny}],
  1];  (* Flatten one level: list of Nx*Ny 3x3 matrices *)
Print[\"CN matrices done. Count: \", Length[cnMatsFlat]];\
\>", "Input",
 CellLabel->
  "In[171]:=",ExpressionUUID->"b5dbd3a2-312e-41f3-91f7-e62dcf3e644b"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"kxGrid sample {n=1,60,61,62,120}: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     FractionBox[
      RowBox[{"59", " ", "\[Pi]"}], "60"], ",", "\[Pi]", ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"59", " ", "\[Pi]"}], "60"]}], ",", 
     RowBox[{"-", 
      FractionBox["\[Pi]", "60"]}]}], "}"}]}],
  SequenceForm[
  "kxGrid sample {n=1,60,61,62,120}: ", {
   0, Rational[59, 60] Pi, Pi, Rational[-59, 60] Pi, Rational[-1, 60] Pi}],
  Editable->False]], "Print",
