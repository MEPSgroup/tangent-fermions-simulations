Cell[CellGroupData[{

Cell["Section 2: Dispersion check -- eigenvalues of P^{-1} H", "Section",ExpressionUUID->"a42b10fd-5a8c-4994-8079-0dd52e55a7ff"],

Cell[CellGroupData[{

Cell["\<\
(* Test dispersion at a generic k-point *)
testKx = 0.3; testKy = 0.5;
Htest = N[HTF[testKx, testKy]];
Ptest = N[PTF[testKx, testKy]];
evsNum = Sort[Re[Eigenvalues[Inverse[Ptest].Htest]]];
eExpected = 2.0 Sqrt[Tan[testKx/2]^2 + Tan[testKy/2]^2];
Print[\"Numerical eigenvalues : \", evsNum];
Print[\"Expected {-E,0,+E}    : \", {-eExpected, 0., eExpected}];

(* Check group velocity from Hellmann-Feynman: vx = <Jx>/<P> *)
(* For s=+1 eigenspinor at angle phi *)
phi0test = ArcTan[Tan[testKx/2], Tan[testKy/2]];
chi0 = (1/2) {Exp[-I phi0test], Sqrt[2], Exp[I phi0test]};
(* Check it is indeed an eigenvector *)
Print[\"Spinor residual (H - E P).chi: \",
  N[Norm[(Htest - evsNum[[3]] Ptest).chi0]]];
(* Group velocity from TF current operator *)
vxHF = Re[(Conjugate[chi0].(N[JxTF[testKx, testKy]].chi0)) /
          (Conjugate[chi0].(Ptest.chi0))];
vxExp = 2 Tan[testKx/2] / (Cos[testKx/2]^2 evsNum[[3]]);
Print[\"vx Hellmann-Feynman: \", vxHF, \"  Expected: \", vxExp];\
\>", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"b026cff3-39f1-4ab7-9b9e-93da58e6a26f"],

