Cell[CellGroupData[{

Cell["Section 6b: Compiled alternative (faster on large grids)", "Section",ExpressionUUID->"fd1e16d9-0bb2-4b35-b805-7a50120ae94f"],

Cell["\<\
(* Alternative Section 6 using Compile for maximum speed.
   Compile generates C-level machine code for the inner loops.
   Use this if the vectorised MapThread version is still slow.
   NOTE: Compile does not support InverseFourier; we compile only
   the matrix-application step and potential kick. *)

(* Compiled potential kick: psiT[[ix,iy,s]] *= Exp[-I V[[ix,iy]] dt] *)
compiledPotKick = Compile[
  {{psiArr, _Complex, 3}, {vArr, _Real, 2}, {dtVal, _Real}},
  Table[Exp[-I vArr[[ix, iy]] dtVal] psiArr[[ix, iy, s]],
        {ix, 1, Dimensions[psiArr][[1]]},
        {iy, 1, Dimensions[psiArr][[2]]},
        {s,  1, 3}],
  CompilationTarget -> \"C\",
  RuntimeOptions -> {\"Speed\"}
];

(* Compiled CN matrix application in k-space:
   Input: psiKflat {Nx*Ny, 3}, cnFlat {Nx*Ny, 3, 3}
   Output: {Nx*Ny, 3} *)
compiledKernels = Compile[
  {{psiKf, _Complex, 2}, {mats, _Complex, 3}},
  Table[
    {mats[[k,1,1]] psiKf[[k,1]] + mats[[k,1,2]] psiKf[[k,2]] + mats[[k,1,3]] \
psiKf[[k,3]],
     mats[[k,2,1]] psiKf[[k,1]] + mats[[k,2,2]] psiKf[[k,2]] + mats[[k,2,3]] \
psiKf[[k,3]],
     mats[[k,3,1]] psiKf[[k,1]] + mats[[k,3,2]] psiKf[[k,2]] + mats[[k,3,3]] \
psiKf[[k,3]]},
    {k, 1, Dimensions[psiKf][[1]]}],
  CompilationTarget -> \"C\",
  RuntimeOptions -> {\"Speed\"}
];

(* Stacked CN matrices as a {Nx*Ny, 3, 3} array for compiledKernels *)
cnMatsArray = N[ArrayReshape[cnMatsFlat, {Nx Ny, 3, 3}]];

(* Time evolution with Compile -- usage is identical to Section 6 *)
psiTC = psiInit;
snapsC = {{0, Table[Total[Abs[psiInit[[ix,iy]]]^2], {ix,1,Nx},{iy,1,Ny}]}};

Print[\"Starting COMPILED time evolution: \", Nsteps, \" steps ...\"];
startTimeC = AbsoluteTime[];

Do[
  (* Potential kick (compiled) *)
  psiTC = compiledPotKick[psiTC, barrierV, dt];

  (* FFT *)
  psiKC = Table[
    Fourier[Table[psiTC[[ix,iy,s]], {ix,1,Nx},{iy,1,Ny}]], {s,1,3}];

  (* Apply CN matrices (compiled): flatten, apply, reshape *)
  psiKflatC = Transpose[ArrayReshape[psiKC, {3, Nx Ny}]]; (* {Nx Ny, 3} *)
  psiKoutFlatC = compiledKernels[psiKflatC, cnMatsArray];  (* {Nx Ny, 3} *)
  psiKout3C = ArrayReshape[Transpose[psiKoutFlatC], {3, Nx, Ny}];

  (* IFFT *)
  psiTC = Transpose[
    Table[InverseFourier[psiKout3C[[s]]], {s,1,3}],
    {2, 3, 1}];

  If[MemberQ[snapTimes, step],
    Module[{dens},
      dens = Table[Total[Abs[psiTC[[ix,iy]]]^2],{ix,1,Nx},{iy,1,Ny}];
      AppendTo[snapsC, {step, dens}];
      Print[\"  compiled snapshot step \", step,
            \", norm = \", N[Total[dens,2]],
            \", elapsed = \", Round[AbsoluteTime[] - startTimeC, 0.1], \" \
s\"]
    ]
  ],
  {step, 1, Nsteps}];

Print[\"Done (compiled). Total time: \", Round[AbsoluteTime[] - startTimeC, \
0.1], \" s\"];
Print[\"Use whichever of Section 6 / 6b is faster on your machine.\"];\
\>", "Input",ExpressionUUID->"6d60bc91-2f2b-4e07-a1e3-a1f68f49af45"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Section 7: Visualisation", "Section",ExpressionUUID->"432bdb67-6dc8-4d31-8138-29e3cc0f7b91"],

Cell["\<\
(* Use whichever snapshots you computed: snaps (Section 6) or snapsC (Section \
6b) *)
snapData = If[Length[snaps] > 1, snaps, snapsC];

densPlots = Table[
  ArrayPlot[
    snapData[[k, 2]],
    ColorFunction -> \"SunsetColors\",
    PlotLabel -> Style[\"t = \" <> ToString[snapData[[k, 1]]] <> \" dt\", 12, \
Bold],
    FrameLabel -> {\"y/a\", \"x/a\"},
    ColorFunctionScaling -> True,
    ImageSize -> 220],
  {k, 1, Length[snapData]}];

Print[Row[densPlots, \"  \"]];

(* Transmitted probability (x > xBarR) *)
transmittedFraction[dens_] :=
  Total[dens[[xBarR + 1 ;;]], 2] / Total[dens, 2];

Print[\"Transmitted fraction at t_final: \",
  N[transmittedFraction[snapData[[-1, 2]]]]];

Print[\"Final norm (should be ~1): \", N[Total[snapData[[-1, 2]], 2]]];

(* 1D density profile along x at final time *)
Print[ListLinePlot[
  Total[snapData[[-1, 2]], {2}],
  PlotLabel -> Style[\"x-integrated density at t_final\", 13],
  AxesLabel -> {\"x site\", \"rho(x)\"},
  PlotStyle -> {Thick, Blue},
  Filling -> Bottom]];\
\>", "Input",ExpressionUUID->"93910cf4-1023-4e1b-bb7a-f7d3f781f49f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Section 8: Dispersion surface (3D band plot)", "Section",ExpressionUUID->"8662fd49-8c74-4c5c-9dc2-4f945eb78b05"],

Cell["\<\
Print[Plot3D[
  2 Sqrt[Tan[kx/2]^2 + Tan[ky/2]^2],
  {kx, -Pi + 0.01, Pi - 0.01},
  {ky, -Pi + 0.01, Pi - 0.01},
  PlotLabel -> Style[\"TF Spin-1: positive band E(kx,ky)\", 14, Bold],
  AxesLabel -> {\"kx\", \"ky\", \"E\"},
  ColorFunction -> \"Rainbow\",
  PlotRange -> {0, 8},
  Mesh -> None,
  ImageSize -> 420]];

(* Also plot the TF current magnitude |Jx| as a function of kx at ky=0 *)
Print[Plot[
  Tr[N[JxTF[kx, 0.0]].N[JxTF[kx, 0.0]]],  (* Tr[Jx^2] as proxy for magnitude *)
  {kx, -Pi + 0.01, Pi - 0.01},
  PlotLabel -> Style[\"Tr[Jx(kx,0)^2]: TF current strength\", 13],
  AxesLabel -> {\"kx\", \"Tr[Jx^2]\"},
  PlotStyle -> {Thick}]];\
\>", "Input",ExpressionUUID->"3eec1227-03f9-48c4-aa29-e6add8a905c2"]
}, Open  ]]
}, Open  ]]
},
