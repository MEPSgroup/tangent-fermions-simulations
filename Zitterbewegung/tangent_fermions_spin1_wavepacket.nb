Cell[CellGroupData[{

Cell["Section 4: Wave-packet parameters and initial state", "Section",ExpressionUUID->"2573f810-948f-4c02-812a-9f827a7c2aa3"],

Cell[CellGroupData[{

Cell["\<\
(* Grid size *)
Nx = 120; Ny = 80;

(* Barrier potential: strip from xBarL to xBarR *)
V0val  = 1.0;
xBarL  = Round[0.45 Nx];
xBarR  = Round[0.55 Nx];
barrierV = Table[
  If[xBarL <= ix <= xBarR, V0val, 0.0],
  {ix, 1, Nx}, {iy, 1, Ny}];

(* Time-stepping *)
dt     = 0.2;
Nsteps = 300;
snapTimes = {0, 50, 150, 300};

(* Gaussian wave-packet parameters *)
sigma = 8.0;
x0 = Round[0.25 Nx];
y0 = Round[0.50 Ny];
k0x = 0.5;
k0y = 0.0;

(* Eigenspinor for the positive-energy band: (1/2)(e^{-i phi}, Sqrt[2], e^{i \
phi}) *)
phi0    = ArcTan[k0x, k0y];
spinor0 = (1/2) {Exp[-I phi0], Sqrt[2], Exp[I phi0]};
Print[\"Spinor L2-norm (should be 1): \", N[Sqrt[Total[Abs[spinor0]^2]]]];

(* Build initial 3-component wave-packet on Nx x Ny real-space grid
   psiInit[[ix, iy]] is a 3-vector *)
psiInit = Table[
  Exp[-((ix - x0)^2 + (iy - y0)^2)/(2 sigma^2)
      - I (k0x (ix - 1) + k0y (iy - 1))] spinor0,
  {ix, 1, Nx}, {iy, 1, Ny}];

(* Normalise *)
normFac = Sqrt[Total[Abs[Flatten[psiInit]]^2]];
psiInit = psiInit / normFac;
Print[\"Initial norm (should be 1): \", N[Total[Abs[Flatten[psiInit]]^2]]];\
\>", "Input",
 CellLabel->
  "In[138]:=",ExpressionUUID->"5374c4ae-4093-453f-a2a6-8a77153b7fe7"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Spinor L2-norm (should be 1): \"\>", "\[InvisibleSpace]", 
   "1.`"}],
  SequenceForm["Spinor L2-norm (should be 1): ", 1.],
  Editable->False]], "Print",
 CellChangeTimes->{4.000277860289229*^9},
 CellLabel->
  "During evaluation of \
In[138]:=",ExpressionUUID->"ab5f47e5-5656-4b23-bbc0-ca20acbf142f"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Initial norm (should be 1): \"\>", "\[InvisibleSpace]", 
   "0.9999999999999992`"}],
  SequenceForm["Initial norm (should be 1): ", 0.9999999999999992],
  Editable->False]], "Print",
 CellChangeTimes->{4.0002778603136806`*^9},
