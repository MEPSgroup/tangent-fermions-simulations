Cell[CellGroupData[{

Cell["Section 8: Dispersion surface (3D band plot)", "Section",ExpressionUUID->"777a5645-135e-4264-9222-3c227a2b4834"],

Cell[CellGroupData[{

Cell["\<\
Print[Plot3D[
  2 Sqrt[Tan[kx/2]^2 + Tan[ky/2]^2],
  {kx, -Pi + 0.01, Pi - 0.01},
  {ky, -Pi + 0.01, Pi - 0.01},
  PlotLabel -> Style[\"TF Spin-1: positive band E(kx,ky)\", 14, Bold],
  AxesLabel -> {\"kx\", \"ky\", \"E\"},
  ColorFunction -> \"Rainbow\",
  PlotRange -> {0, 8},
  Mesh -> None,
  ImageSize -> 420]];

(* Also plot the TF current magnitude |Jx| as a function of kx at ky=0 *)
Print[Plot[
  Tr[N[JxTF[kx, 0.0]].N[JxTF[kx, 0.0]]],  (* Tr[Jx^2] as proxy for magnitude *)
  {kx, -Pi + 0.01, Pi - 0.01},
  PlotLabel -> Style[\"Tr[Jx(kx,0)^2]: TF current strength\", 13],
  AxesLabel -> {\"kx\", \"Tr[Jx^2]\"},
  PlotStyle -> {Thick}]];\
\>", "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"05f210d7-2939-42a8-b227-0897dfded80e"],

