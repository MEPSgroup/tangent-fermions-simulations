  "0", ",", "30", ",", "60", ",", "90", ",", "120", ",", "150", ",", "180", ",",
    "210", ",", "240", ",", "270", ",", "300"}], "}"}]], "Output",
 CellChangeTimes->{4.0003596401841097`*^9},
 CellLabel->
  "Out[285]=",ExpressionUUID->"e25d745f-f20e-41c1-b02e-c6fee1279281"]
